_commit='4f508be500dea6e5732cc3d50382a0048b17e7b1'
# Fork (custom branch): quickshell itself now comes from the official repos
# instead of being built from this pinned commit. 4f508be5 is the v0.3.2 tag,
# the version Arch/CachyOS ship. Upstream changes `_commit` when it needs a
# newer quickshell, and that line then conflicts on rebase: that is the cue to
# check the official package has caught up (and raise `_quickshell_min`).
# Useful links:
# https://git.outfoxxed.me/quickshell/quickshell/commits/branch/master
# https://archlinux.org/packages/extra/x86_64/quickshell/

groups=(illogical-impulse)
_prefix='illogical-impulse'
_pkgname=quickshell
_quickshell_min=0.3.2
pkgname="$_prefix-$_pkgname-git"
pkgver=0.1.0.r1
pkgrel=10
pkgdesc="Official $_pkgname plus the extra deps of $_prefix"
arch=(any)
url='https://git.outfoxxed.me/quickshell/quickshell'
license=('LGPL-3.0-only')
depends=(
  "quickshell>=$_quickshell_min"
  # NOTE: Below are custom dependencies of illogical-impulse
  qt6-5compat
  kimageformats  # official AVIF/HEIF/JXL readers; replaces qt6-avif-image-plugin (AUR)
  qt6-imageformats
  qt6-multimedia
  qt6-positioning
  qt6-quicktimeline
  qt6-sensors
  qt6-svg
  qt6-tools
  qt6-translations
  qt6-virtualkeyboard
  qt6-wayland
  kirigami
  kdialog
  syntax-highlighting
)
