  'qt6-declarative'
  'kcoreaddons'
  'kcmutils'
  'kcolorscheme'
  'kconfig'
  'kguiaddons'
  'kiconthemes'
  'kwindowsystem'
  'frameworkintegration'
  'libplasma'
)
conflicts=('darkly')
source=("${url}/releases/download/v${pkgver}/darkly-${pkgver}-x86_64.pkg.zst")
